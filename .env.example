# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/inknpaper?schema=public"

# Secret used to sign/encrypt auth sessions and tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app (used for absolute links, metadata, etc.).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: passwords for the seed script's demo accounts. If unset, the
# seed script falls back to insecure development-only defaults — always
# set these outside of local development.
SEED_SUPER_ADMIN_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_EDITOR_PASSWORD=""
SEED_AUTHOR_PASSWORD=""
SEED_READER_PASSWORD=""
